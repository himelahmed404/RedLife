# Copy to .env and fill in. Never commit the real .env.

# Better Auth: a long random secret, and this app's own URL
# (production: https://<your-client>.vercel.app, no trailing slash)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string (same database as the server)
MONGO_URI=

# ImgBB API key for avatar uploads (https://api.imgbb.com/)
NEXT_PUBLIC_IMGBB_API_KEY=

# Express API URL (production: https://<your-server>.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
